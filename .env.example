# Plantilla de variables de entorno para Los Andes Inmobiliaria
# En Neon PostgreSQL, utilice 'sslmode=verify-full' para evitar advertencias de seguridad en node-postgres.
DATABASE_URL="postgresql://usuario:contraseña@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
JWT_SECRET="clave-secreta-para-firmar-sesiones-jwt"

