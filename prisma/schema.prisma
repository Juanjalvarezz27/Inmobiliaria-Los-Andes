// Esquema de base de datos para Los Andes Inmobiliaria

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

enum OperationType {
  SALE
  RENT
}

enum PropertyType {
  TOWNHOUSE
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
  OFFICE
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  HIDDEN
  ARCHIVED
}

enum InquiryStatus {
  PENDING
  CONTACTED
  DISCARDED
}

// Usuario del sistema: Administrador o Asesor Inmobiliario
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  phone        String?
  avatarUrl    String?
  position     String     @default("Asesor Inmobiliario")
  instagram    String?
  role         Role       @default(AGENT)
  isActive     Boolean    @default(true)
  featured     Boolean    @default(false)
  properties   Property[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

// Publicacion de inmueble
model Property {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  description      String          @db.Text
  operationType    OperationType
  propertyType     PropertyType
  customPropertyType String?
  status           PropertyStatus  @default(AVAILABLE)
  price            Decimal         @db.Decimal(12, 2)
  currency         String          @default("USD")
  featured         Boolean         @default(false)
  bedrooms         Int?
  bathrooms        Int?
  parkingSpots     Int?
  areaSquareMeters Decimal?        @db.Decimal(8, 2)
  lotSquareMeters  Decimal?        @db.Decimal(8, 2)
  yearBuilt        Int?
  city             String          @default("Trujillo Capital")
  sector           String?
  address          String
  state            String          @default("Trujillo")
  latitude         Float?
  longitude        Float?
  googleMapsUrl    String?
  amenities        String[]        @default([])
  agentId          String
  agent            User            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  images           PropertyImage[]
  inquiries        Inquiry[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, operationType])
  @@index([propertyType])
  @@index([city, sector])
  @@map("properties")
}

// Fotografia de una propiedad
model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  publicId   String?
  caption    String?
  order      Int      @default(0)
  isMain     Boolean  @default(false)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId, order])
  @@map("property_images")
}

// Mensaje de contacto desde el catalogo
model Inquiry {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String        @db.Text
  status     InquiryStatus @default(PENDING)
  propertyId String?
  property   Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@map("inquiries")
}
