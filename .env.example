# ==============================================================================
# Plantilla de Variables de Entorno - Inmobiliaria Los Andes
# ==============================================================================

# Base de datos Serverless (Neon PostgreSQL)
# En Neon, incluya sslmode=verify-full y channel_binding=require para conexiones seguras
DATABASE_URL="postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Seguridad y Autenticación Administrativa
# Clave aleatoria de al menos 32 caracteres para firmar los tokens JWT de sesión
JWT_SECRET="losandes-inmobiliaria-secure-jwt-secret-key-2026-production"

# Almacenamiento de Fotografías (UploadThing CDN)
# Token de la cuenta principal de UploadThing para carga de imágenes de inmuebles y asesores
UPLOADTHING_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Cuenta secundaria de UploadThing (Opcional - Balanceo de carga y failover automático)
# UPLOADTHING_TOKEN_2="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Configuración del Sitio y Dominio Canónico (Producción)
NEXT_PUBLIC_SITE_URL="https://inmobiliarialosandes.com"

# Teléfono Central de WhatsApp (Opcional - Formato internacional sin símbolos, ej: 584120000000)
# NEXT_PUBLIC_CENTRAL_PHONE="584120000000"
